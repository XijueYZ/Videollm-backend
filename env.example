# VideoLLM Backend 环境变量配置

# Flask应用配置
SECRET_KEY=videollm-secret-key-2024
DEBUG=false
FLASK_ENV=production

# 服务器配置
HOST=0.0.0.0
PORT=5000

# 模型池配置
MODEL_POOL_SIZE=8
MODEL_ACQUIRE_TIMEOUT=0.1

# 日志配置
LOG_LEVEL=INFO

# 模型相关配置
MAX_TOKENS=2048
TEMPERATURE=0.7
MODEL_PATH=./models/

# 数据库配置（如果需要）
# DATABASE_URL=sqlite:///videollm.db

# Redis配置（如果需要缓存）
# REDIS_URL=redis://localhost:6379/0

# 其他配置
CORS_ORIGINS=* 